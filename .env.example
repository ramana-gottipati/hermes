# Copy to .env and fill in real values. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
HERMES_DEFAULT_MODEL=claude-sonnet-4-6
HERMES_FAST_MODEL=claude-haiku-4-5

# --- Server ---
HERMES_HOST=0.0.0.0
HERMES_PORT=8000
HERMES_LOG_LEVEL=INFO

# --- Assistant: Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Trading ---
# Live trading is OFF by default. Set to true only after paper-mode validation.
TRADING_LIVE=false
# Example: Zerodha Kite, Alpaca, Binance — pick one when ready
BROKER_API_KEY=
BROKER_API_SECRET=

# --- Datastore ---
# Start with SQLite; switch to postgres://... when ready
DATABASE_URL=sqlite:///./data/hermes.db
