# AUD-81 — deterministic line endings for the shared Windows tree.
#
# The repo is edited on Windows (core.autocrlf=true → CRLF worktrees) but deploys to a Linux VPS
# by scp, and LF-writing tools (Claude's editors) hitting a CRLF file produced mixed endings and
# whole-file diff churn (e.g. PROJECT_STATE.md). The index was already all-LF; this makes LF the
# committed AND worktree convention explicitly + durably across every session/clone, overriding
# core.autocrlf, so CRLF can never reach the VPS and diffs stay clean.

# Default: text files are normalized to LF in the repo and checked out as LF.
* text=auto eol=lf

# Source + deploy-critical (explicit — belt-and-suspenders): always LF.
*.py       text eol=lf
*.sh       text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.conf     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.sql      text eol=lf
*.svg      text eol=lf
*.csv      text eol=lf
*.example  text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf

# Windows batch files run on the laptop — keep CRLF.
*.bat      text eol=crlf

# Binary — never touch (protects them from text=auto normalization).
*.db       binary
*.sqlite   binary
*.pkl      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.docx     binary
*.xlsx     binary
*.zip      binary
*.gz       binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
